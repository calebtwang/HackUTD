# Copy to .env without overwriting an existing configuration.
# Keep one private .env in this project directory. Values load at startup;
# restart the app after editing. .env and .local/ are ignored by Git.
PORT=3210
WEBHOOK_PORT=3211
# Local development leaves public origins blank. Production uses compiled dist/.
# For the private Docker network set NODE_ENV=production and HOST=0.0.0.0.
NODE_ENV=development
HOST=127.0.0.1
# Set BOTH HTTPS origins for hosted mode; do not include paths or trailing slashes.
MANAGER_PUBLIC_ORIGIN=
DEMO_PUBLIC_ORIGIN=
# Optional comma-separated HTTPS origins for additional owned demo hostnames.
DEMO_PUBLIC_ALIASES=
# Hosted control access; use a private random code at least 12 characters long.
# Public visitors can view limited state. The code unlocks controls and diagnostics.
JUDGE_ACCESS_CODE=
# Use the host/name and publishing-owner token for YOUR database.
# Maincloud host: https://maincloud.spacetimedb.com
SPACETIMEDB_HOST=http://127.0.0.1:3000
SPACETIMEDB_DATABASE=honeyline-demo
SPACETIMEDB_TOKEN=

# Stable private shared secrets. Put the existing values here when consolidating
# an installation; do not rotate them during an ordinary restart.
# The app retains legacy .local/ generation/fallbacks when these are blank.
# The parent app passes WORKER_SECRET to its workers.
WORKER_SECRET=
VOICE_TOOL_SECRET=

# OpenAI-compatible chat/completions API, including the provider's API base path.
# Live mode requires all three values and never silently falls back to fixture rules.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Photon calls route directly by SIP; saving its key alone does not purchase a
# number, configure routing, or enable texting.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
ELEVENLABS_API_KEY=

# HTTPS origin only. Point at the webhook receiver, not the local dashboard.
PUBLIC_WEBHOOK_URL=
# Saved automatically by the ElevenLabs configuration script for its HMAC webhook.
ELEVENLABS_WEBHOOK_SECRET=

# Provide BOTH existing SIP credentials here; configure the same pair in Photon.
# Fresh installs can still use the setup script's legacy generated-file fallback.
ELEVENLABS_SIP_USERNAME=
ELEVENLABS_SIP_PASSWORD=

# Real, already-provisioned E.164 numbers only. Blank means DEMO-<AGENT> when no
# legacy profile number exists. The two configured agents are Mara and Otis.
# .local/ keeps resource mappings and the separate voiceReady flags, which are
# enabled only after successful call tests. Keep assigned IDs consistent here.
SCOUT_PHONE=
SCOUT_ELEVENLABS_AGENT_ID=
FINCH_PHONE=
FINCH_ELEVENLABS_AGENT_ID=

# Optional stock voice IDs; otherwise setup selects available stock voices.
SCOUT_ELEVENLABS_VOICE_ID=
FINCH_ELEVENLABS_VOICE_ID=
