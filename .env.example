# Copy to .env without overwriting an existing configuration.
# .env and .local/ contain private state and are ignored by Git.
PORT=3210
WEBHOOK_PORT=3211
# Use the host/name and publishing-owner token for YOUR database.
# Maincloud host: https://maincloud.spacetimedb.com
SPACETIMEDB_HOST=http://127.0.0.1:3000
SPACETIMEDB_DATABASE=honeyline-demo
SPACETIMEDB_TOKEN_FILE=.local/admin-token
# Optional inline alternative; when nonempty this takes precedence over TOKEN_FILE.
SPACETIMEDB_TOKEN=

# Leave blank to generate private values in .local/ on first app launch.
# Keep stable across restarts. The parent app passes WORKER_SECRET to its workers.
WORKER_SECRET=
VOICE_TOOL_SECRET=

# OpenAI-compatible chat/completions API, including the provider's API base path.
# Live mode requires all three values and never silently falls back to fixture rules.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Photon calls route directly by SIP; saving its key alone does not purchase a
# number, configure routing, or enable texting.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
ELEVENLABS_API_KEY=

# HTTPS origin only. Point at the webhook receiver, not the local dashboard.
PUBLIC_WEBHOOK_URL=
# Saved automatically by the ElevenLabs configuration script for its HMAC webhook.
ELEVENLABS_WEBHOOK_SECRET=

# Optional: provide BOTH, or let setup generate .local/elevenlabs-sip.json.
# Configure the same pair in Photon.
ELEVENLABS_SIP_USERNAME=
ELEVENLABS_SIP_PASSWORD=

# Real, already-provisioned E.164 numbers only. Blank means DEMO-<AGENT> in rehearsal.
# Setup also saves generated agent IDs in .local/personas.json. Readiness is the
# separate voiceReady flag in that file, set only after a successful call test.
SCOUT_PHONE=
SCOUT_ELEVENLABS_AGENT_ID=
FINCH_PHONE=
FINCH_ELEVENLABS_AGENT_ID=
WREN_PHONE=
WREN_ELEVENLABS_AGENT_ID=

# Optional stock voice IDs; otherwise setup selects available stock voices.
SCOUT_ELEVENLABS_VOICE_ID=
FINCH_ELEVENLABS_VOICE_ID=
WREN_ELEVENLABS_VOICE_ID=
